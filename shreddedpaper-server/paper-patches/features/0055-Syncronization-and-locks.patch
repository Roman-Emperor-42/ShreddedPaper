     public static void setNeedsBroadcast(LevelChunk chunk) {
         if (thisThreadToBroadcast.get() != null && TickThread.isTickThreadFor(chunk.getLevel(), chunk.getPos())) {
diff --git a/io/multipaper/shreddedpaper/threading/ShreddedPaperChunkTicker.java b/io/multipaper/shreddedpaper/threading/ShreddedPaperChunkTicker.java
