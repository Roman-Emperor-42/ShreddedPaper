diff --git a/io/multipaper/shreddedpaper/threading/ShreddedPaperEntityTicker.java b/io/multipaper/shreddedpaper/threading/ShreddedPaperEntityTicker.java
index ab51946555b14c60a633bb29ca389837f9d8764c..e851b4fa86949c13f477e7da3a5b559497586cc5 100644
--- a/io/multipaper/shreddedpaper/threading/ShreddedPaperEntityTicker.java
+++ b/io/multipaper/shreddedpaper/threading/ShreddedPaperEntityTicker.java
@@ -4,6 +4,7 @@ import net.minecraft.server.MinecraftServer;
 import net.minecraft.server.level.ChunkMap;
 import net.minecraft.server.level.ServerLevel;
 import net.minecraft.world.entity.Entity;
+import net.minecraft.world.entity.Mob;
 
 import java.util.Objects;
 
@@ -14,38 +15,43 @@ public class ShreddedPaperEntityTicker {
 
         entity.activatedPriorityReset = false; // Pufferfish - DAB
         if (!entity.isRemoved()) {
-            if (false && level.shouldDiscardEntity(entity)) { // CraftBukkit - We prevent spawning in general, so this butchering is not needed
