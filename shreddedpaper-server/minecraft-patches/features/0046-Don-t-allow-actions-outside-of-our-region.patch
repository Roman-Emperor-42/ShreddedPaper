@@ -836,7 +836,7 @@ public final class RegionizedPlayerChunkLoader {
                     break;
                 }
                 if (!((ChunkSystemLevelChunk)chunk).moonrise$isPostProcessingDone()) {
-2                    // ShreddedPaper start - run on region's thread with write lock
