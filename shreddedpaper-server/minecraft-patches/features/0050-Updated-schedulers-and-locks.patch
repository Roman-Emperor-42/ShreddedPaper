+        if (mainExec.isSameThread()) {
+            return regionsLock.write(() -> regions.computeIfAbsent(regionPos.longKey, k -> new LevelChunkRegion(level, regionPos)));
+        }
+        // if on worker, hand off to main and wait, no lock
+        CompletableFuture<LevelChunkRegion> cf = new CompletableFuture<>();
+        mainExec.execute(() -> {
+            LevelChunkRegion made = regionsLock.write(() ->
+                    regions.computeIfAbsent(regionPos.longKey, k -> new LevelChunkRegion(level, regionPos))
+            );
+            cf.complete(made);
+        });
+        // Join is safe here because we didn't take any locks
+        return cf.join();
     }
 
