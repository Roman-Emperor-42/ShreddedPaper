+        }
+        // Create the region, then enqueue onto the region queue
+        return this.mainThreadExecutor.queueRunnable(() -> {
+            final LevelChunkRegion created = world.chunkSource.tickingRegions.getOrCreate(regionPos);
+            created.getInternalTaskQueue().queueRunnable(run, priority);
+        }, priority);
     }
 
