+        List<LevelChunkRegion> snapshot = new ArrayList<>();
+        if (regionsLock.tryRead(() -> {
+            var it = regions.long2ObjectEntrySet().fastIterator();
+            while (it.hasNext()) snapshot.add(it.next().getValue());
+        })) {
+            for (var r : snapshot) consumer.accept(r);
+            return;
+        }
+
+        // defer to main, but still snapshot under read, then iterate outside
+        level.getChunkSource().mainThreadProcessor.execute(() -> {
+            List<LevelChunkRegion> snap = new ArrayList<>();
+            regionsLock.read(() -> {
+                var it = regions.long2ObjectEntrySet().fastIterator();
+                while (it.hasNext()) snap.add(it.next().getValue());
+            });
+            for (var r : snap) consumer.accept(r);
+        });
     }
 
