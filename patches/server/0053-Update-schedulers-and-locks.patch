     public PrioritisedExecutor.PrioritisedTask createChunkTask(final int chunkX, final int chunkZ, final Runnable run,
                                                                final PrioritisedExecutor.Priority priority) {
-        return world.chunkSource.tickingRegions.getOrCreate(RegionPos.forChunk(new ChunkPos(chunkX, chunkZ))).getInternalTaskQueue().createTask(run, priority); // ShreddedPaper
-        // return this.mainThreadExecutor.createTask(run, priority); // ShreddedPaper
+        final RegionPos regionPos = RegionPos.forChunk(new ChunkPos(chunkX, chunkZ));
+        final LevelChunkRegion existing = world.chunkSource.tickingRegions.get(regionPos);
+        if (existing != null) {
+            return existing.getInternalTaskQueue().createTask(run, priority);
+        }
+        // Create the region, then enqueue onto the region queue
+        return this.mainThreadExecutor.createTask(() -> {
