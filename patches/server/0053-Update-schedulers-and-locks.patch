     public LevelChunkRegion getOrCreate(RegionPos regionPos) {
-        LevelChunkRegion levelChunkRegion = get(regionPos);
+        LevelChunkRegion existing = get(regionPos);
+        if (existing != null) return existing;
 
-        if (levelChunkRegion != null) {
-            return levelChunkRegion;
+        // Non-blocking write attempt
+        boolean created = regionsLock.tryWrite(() -> {
+            regions.computeIfAbsent(regionPos.longKey, k -> new LevelChunkRegion(level, regionPos));
+        });
+        if (created) {
+            return regions.get(regionPos.longKey);
+        }
+
+        // If we on main, block & create now.
+        final var mainExec = level.getChunkSource().mainThreadProcessor;
+        if (mainExec.isSameThread()) {
+            return regionsLock.write(() -> regions.computeIfAbsent(regionPos.longKey, k -> new LevelChunkRegion(level, regionPos)));
